<%- include('includes/navbar'); %>

<section class="container">
    <div class="marca">
        <h2>Bem vindo ao Sistema de Cadastro de Produtos</h2>
        <p>Não tem uma conta?</p>
        <a id="direciona-register" href="/register">Crie uma Conta</a>
    </div>

    <div class="formulario">
        <h1 class="titulo-login">Entre com a Sua Conta</h1>
        <%- include('includes/errorMessages'); %>
        <form action="/login" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="text" name="email" placeholder="Seu E-mail"><br>
            <input type="password" name="senha" placeholder="Sua Senha"><br>
            <button type="submit" class="btn-logar">Entrar</button>
        </form>
    </div>
</section>

<script type="module" src="/frontend/js/main.js"></script>
<%- include('includes/footer'); %>